<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Feasibility spike (throwaway). Not part of the product; never referenced from src/.
    OutputType is Exe (not WinExe) so `- -check` and `- -tray` can print to the console
    under `dotnet run`. There is deliberately no App.xaml: the WPF Application is created
    in code so the project has exactly one entry point.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Spike</RootNamespace>
    <AssemblyName>Spike</AssemblyName>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!-- Floating versions: this is a throwaway spike; the real projects pin exact versions. -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.*" />
    <PackageReference Include="H.NotifyIcon.Wpf" Version="2.*" />
  </ItemGroup>

</Project>
