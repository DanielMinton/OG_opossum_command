<?xml version="1.0" encoding="utf-8"?>
<!--
  Repo-level NuGet sources (ADR-015). The user-level %APPDATA%\NuGet\nuget.config on this PC
  has an empty <packageSources> list, so without this file every restore fails with NU1100.
  Kept inside the repo so the build never edits anything outside the project root.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
