<Window x:Class="OG_opossum_command.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:a11y="clr-namespace:OG_opossum_command.Desktop.Accessibility"
        xmlns:shell="clr-namespace:OG_opossum_command.Desktop.Shell"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=shell:ShellViewModel}"
        Title="OG Opossum Command Central"
        Icon="/Assets/app.ico"
        Height="700" Width="1040"
        MinHeight="480" MinWidth="760"
        WindowStartupLocation="CenterScreen"
        KeyboardNavigation.TabNavigation="Cycle"
        FontSize="{DynamicResource OgocBodySize}"
        AutomationProperties.Name="OG Opossum Command Central">
    <!-- Ctrl+1..6 run the dashboard tiles from any page (ADR-057). -->
    <Window.InputBindings>
        <KeyBinding Modifiers="Ctrl" Key="D1" Command="{Binding RunTileCommand}" CommandParameter="1" />
        <KeyBinding Modifiers="Ctrl" Key="D2" Command="{Binding RunTileCommand}" CommandParameter="2" />
        <KeyBinding Modifiers="Ctrl" Key="D3" Command="{Binding RunTileCommand}" CommandParameter="3" />
        <KeyBinding Modifiers="Ctrl" Key="D4" Command="{Binding RunTileCommand}" CommandParameter="4" />
        <KeyBinding Modifiers="Ctrl" Key="D5" Command="{Binding RunTileCommand}" CommandParameter="5" />
        <KeyBinding Modifiers="Ctrl" Key="D6" Command="{Binding RunTileCommand}" CommandParameter="6" />
    </Window.InputBindings>
    <!-- Layout (ADR-055): navigation rail on the left, page header and the current view on the right.
         No window Background: the Fluent theme paints it (Mica on Windows 11). -->
    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Auto: the rail widens with text scaling instead of clipping its labels (ADR-055). -->
            <ColumnDefinition Width="Auto" MinWidth="208" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Navigation rail -->
        <DockPanel Grid.Column="0" Margin="12,16,8,16" LastChildFill="False">
            <Grid DockPanel.Dock="Top" Margin="8,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Image Grid.Column="0" Source="/Assets/app.ico" Width="36" Height="36" Margin="0,0,10,0"
                       VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"
                       a11y:Motion.Entrance="True"
                       AutomationProperties.Name="OG Opossum logo" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="OG Opossum" FontSize="{DynamicResource OgocLargeSize}" FontWeight="SemiBold" />
                    <TextBlock Text="Command Central" Style="{StaticResource OgocCaption}" />
                </StackPanel>
            </Grid>

            <StackPanel DockPanel.Dock="Top" AutomationProperties.Name="Pages">
                <RadioButton GroupName="Nav"
                             Style="{StaticResource OgocNavItem}"
                             IsChecked="{Binding IsDashboardPage, Mode=OneWay}"
                             Command="{Binding ShowDashboardCommand}"
                             AutomationProperties.Name="Show dashboard">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource OgocIcon}" Text="&#xE80F;" />
                        <AccessText Text="_Dashboard" VerticalAlignment="Center" />
                    </StackPanel>
                </RadioButton>
                <RadioButton GroupName="Nav"
                             Style="{StaticResource OgocNavItem}"
                             IsChecked="{Binding IsHistoryPage, Mode=OneWay}"
                             Command="{Binding ShowHistoryCommand}"
                             AutomationProperties.Name="Show history">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource OgocIcon}" Text="&#xE81C;" />
                        <AccessText Text="_History" VerticalAlignment="Center" />
                    </StackPanel>
                </RadioButton>
                <RadioButton GroupName="Nav"
                             Style="{StaticResource OgocNavItem}"
                             IsChecked="{Binding IsSettingsPage, Mode=OneWay}"
                             Command="{Binding ShowSettingsCommand}"
                             AutomationProperties.Name="Show settings">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource OgocIcon}" Text="&#xE713;" />
                        <AccessText Text="_Settings" VerticalAlignment="Center" />
                    </StackPanel>
                </RadioButton>
            </StackPanel>

            <StackPanel DockPanel.Dock="Bottom">
                <Button Style="{StaticResource OgocNavItem}"
                        Command="{Binding OpenPaletteCommand}"
                        AutomationProperties.Name="Open the command palette"
                        AutomationProperties.HelpText="Also opened by the global hotkey, Ctrl+Alt+Space by default">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource OgocIcon}" Text="&#xE721;" />
                        <AccessText Text="Command _palette" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource OgocNavItem}"
                        Command="{Binding HideCommand}"
                        Margin="0"
                        AutomationProperties.Name="Hide window to tray">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource OgocIcon}" Text="&#xE921;" />
                        <AccessText Text="Hide to _tray" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </DockPanel>

        <!-- Page -->
        <Grid Grid.Column="1" Margin="16,16,24,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding PageTitle}"
                               FontFamily="{StaticResource OgocDisplayFont}"
                               FontSize="{DynamicResource OgocDisplaySize}"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"
                               AutomationProperties.HeadingLevel="Level1" />
                    <TextBlock Text="{Binding PageSubtitle}" Style="{StaticResource OgocCaption}" FontSize="{DynamicResource OgocBodySize}" Margin="1,2,0,0" />
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Label Content="Pro_file" Target="{Binding ElementName=ProfilePicker}" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <!-- The wheel never changes the profile: switching Work and Personal takes a click or the keyboard (ADR-055). -->
                    <ComboBox x:Name="ProfilePicker"
                              MinWidth="140"
                              ItemsSource="{Binding Profiles}"
                              SelectedItem="{Binding ActiveProfile, Mode=TwoWay}"
                              FocusVisualStyle="{StaticResource OgocFocusVisual}"
                              a11y:WheelPassThrough.IsEnabled="True"
                              AutomationProperties.Name="Active profile" />
                </StackPanel>

                <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                        HorizontalAlignment="Left"
                        Margin="0,8,0,0"
                        Padding="10,3,12,3"
                        CornerRadius="12"
                        Background="{DynamicResource SystemFillColorSuccessBackgroundBrush}">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center"
                                 Fill="{DynamicResource SystemFillColorSuccessBrush}" />
                        <TextBlock Text="{Binding HostStatus}"
                                   FontSize="{DynamicResource OgocSmallSize}"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center"
                                   a11y:LiveRegion.Announce="True" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Dashboard, History or Settings -->
            <ContentControl Grid.Row="1"
                            Content="{Binding CurrentView}"
                            Focusable="False" />
        </Grid>
    </Grid>
</Window>
