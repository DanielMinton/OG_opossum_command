<UserControl x:Class="OG_opossum_command.Desktop.Settings.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:a11y="clr-namespace:OG_opossum_command.Desktop.Accessibility"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:OG_opossum_command.Desktop.Settings"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=local:SettingsViewModel}"
             Focusable="False"
             AutomationProperties.Name="Settings">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
        <StackPanel Margin="6">
            <TextBlock Style="{StaticResource OgocHeading}" Text="COMMAND PALETTE HOTKEY" />
            <!-- Declared label, box, button so Tab order matches what is on screen. -->
            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Label Grid.Column="0" Content="Hot_key:" Target="{Binding ElementName=HotkeyBox}" VerticalAlignment="Center" />
                <TextBox x:Name="HotkeyBox"
                         Grid.Column="1"
                         MinWidth="200"
                         VerticalContentAlignment="Center"
                         Text="{Binding HotkeyText, UpdateSourceTrigger=PropertyChanged}"
                         FocusVisualStyle="{StaticResource OgocFocusVisual}"
                         AutomationProperties.Name="Command palette hotkey"
                         AutomationProperties.HelpText="Modifiers plus one key, for example Ctrl+Alt+Space" />
                <Button Grid.Column="2"
                        Content="_Apply"
                        Style="{StaticResource OgocButton}"
                        Command="{Binding ApplyHotkeyCommand}"
                        Margin="8,0,0,0"
                        AutomationProperties.Name="Apply hotkey" />
            </Grid>
            <TextBlock Text="{Binding HotkeyStatus}" TextWrapping="Wrap" Margin="0,0,0,12" a11y:LiveRegion.Announce="True" />

            <TextBlock Style="{StaticResource OgocHeading}" Text="NOTIFICATIONS AND SCHEDULES" />
            <CheckBox Content="_Quiet mode (only failures and runs that need attention show a notification)"
                      IsChecked="{Binding QuietMode}"
                      Margin="0,0,0,6"
                      FocusVisualStyle="{StaticResource OgocFocusVisual}"
                      AutomationProperties.Name="Quiet mode" />
            <CheckBox Content="Pa_use all schedules (occurrences while paused are skipped, not deferred)"
                      IsChecked="{Binding SchedulesPaused}"
                      Margin="0,0,0,12"
                      FocusVisualStyle="{StaticResource OgocFocusVisual}"
                      AutomationProperties.Name="Pause all schedules" />

            <TextBlock Style="{StaticResource OgocHeading}" Text="SCHEDULES (edit the workflow file to change one)" />
            <TextBlock Text="No workflow has a schedule trigger."
                       Margin="0,0,0,12"
                       Visibility="{Binding HasNoSchedules, Converter={StaticResource BoolToVis}}" />
            <ListView ItemsSource="{Binding Schedules}"
                      Style="{StaticResource OgocList}"
                      MaxHeight="220"
                      Margin="0,0,0,12"
                      SelectionMode="Single"
                      Visibility="{Binding HasSchedules, Converter={StaticResource BoolToVis}}"
                      AutomationProperties.Name="Schedules">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Workflow" Width="150" DisplayMemberBinding="{Binding Workflow}" />
                        <GridViewColumn Header="Profile" Width="80" DisplayMemberBinding="{Binding Profile}" />
                        <GridViewColumn Header="Schedule" Width="220" DisplayMemberBinding="{Binding Schedule}" />
                        <GridViewColumn Header="Next" Width="130" DisplayMemberBinding="{Binding NextDue}" />
                        <GridViewColumn Header="Last outcome" Width="260" DisplayMemberBinding="{Binding LastOutcome}" />
                    </GridView>
                </ListView.View>
            </ListView>

            <!-- Read-only export state (ADR-050..052). Change it in profiles\<Profile>\profile.json ("exports"). -->
            <TextBlock Style="{StaticResource OgocHeading}"
                       Text="EXPORTS (status.json, alert outbox, carryovers; set in profile.json)" />
            <ItemsControl ItemsSource="{Binding Exports}"
                          Margin="0,0,0,12"
                          Focusable="False"
                          AutomationProperties.Name="Exports">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type local:ExportsRow}">
                        <StackPanel Margin="0,0,0,6" AutomationProperties.Name="{Binding AutomationName}">
                            <TextBlock Text="{Binding Profile}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Folder}" TextWrapping="Wrap" FontSize="{DynamicResource OgocSmallSize}" Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
                            <TextBlock Text="{Binding Status}" TextWrapping="Wrap" FontSize="{DynamicResource OgocSmallSize}" />
                            <TextBlock Text="{Binding Alerts}" TextWrapping="Wrap" FontSize="{DynamicResource OgocSmallSize}" />
                            <TextBlock Text="{Binding Carryovers}" TextWrapping="Wrap" FontSize="{DynamicResource OgocSmallSize}" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Style="{StaticResource OgocHeading}" Text="DATA FOLDER" />
            <TextBox Text="{Binding DataRoot, Mode=OneWay}"
                     IsReadOnly="True"
                     BorderThickness="0"
                     Background="Transparent"
                     FocusVisualStyle="{StaticResource OgocFocusVisual}"
                     AutomationProperties.Name="Data folder path" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
