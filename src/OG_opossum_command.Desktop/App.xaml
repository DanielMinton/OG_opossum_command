<Application x:Class="OG_opossum_command.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dashboard="clr-namespace:OG_opossum_command.Desktop.Dashboard"
             xmlns:history="clr-namespace:OG_opossum_command.Desktop.History"
             xmlns:settings="clr-namespace:OG_opossum_command.Desktop.Settings"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             ShutdownMode="OnExplicitShutdown">
    <!-- No StartupUri: Program.Main decides whether a window is shown at all. -->
    <Application.Resources>

        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- Font sizes: rewritten at startup and on settings change by Accessibility/FontScale (system message font). -->
        <sys:Double x:Key="OgocBodySize">14</sys:Double>
        <sys:Double x:Key="OgocSmallSize">12</sys:Double>
        <sys:Double x:Key="OgocHeadingSize">13</sys:Double>
        <sys:Double x:Key="OgocLargeSize">16</sys:Double>
        <sys:Double x:Key="OgocTitleSize">20</sys:Double>

        <!-- Focus ring for list rows: inside the row so neighbours do not overlap it. -->
        <Style x:Key="OgocItemFocusVisual">
            <Setter Property="Control.Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Rectangle StrokeThickness="2"
                                   Stroke="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"
                                   SnapsToDevicePixels="True" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ListViewItem" BasedOn="{StaticResource {x:Type ListViewItem}}">
            <Setter Property="FocusVisualStyle" Value="{StaticResource OgocItemFocusVisual}" />
        </Style>

        <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
            <Setter Property="FocusVisualStyle" Value="{StaticResource OgocItemFocusVisual}" />
        </Style>

        <!-- Colours come from SystemColors so Windows high-contrast themes apply automatically. -->
        <Style x:Key="OgocFocusVisual">
            <Setter Property="Control.Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Rectangle Margin="-3"
                                   StrokeThickness="3"
                                   Stroke="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"
                                   SnapsToDevicePixels="True" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OgocButton" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{StaticResource OgocFocusVisual}" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="FontSize" Value="{DynamicResource OgocBodySize}" />
            <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" />
            <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.ControlBrushKey}}" />
            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}" />
        </Style>

        <Style x:Key="OgocTile" TargetType="Button" BasedOn="{StaticResource OgocButton}">
            <Setter Property="MinHeight" Value="84" />
            <Setter Property="Margin" Value="6" />
            <Setter Property="FontSize" Value="{DynamicResource OgocLargeSize}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="OgocCancel" TargetType="Button" BasedOn="{StaticResource OgocButton}">
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="MinWidth" Value="120" />
            <Setter Property="MinHeight" Value="44" />
            <Setter Property="BorderThickness" Value="2" />
        </Style>

        <Style x:Key="OgocHeading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{DynamicResource OgocHeadingSize}" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" />
        </Style>

        <Style x:Key="OgocList" TargetType="ListView">
            <Setter Property="FocusVisualStyle" Value="{StaticResource OgocFocusVisual}" />
            <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
            <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}" />
        </Style>

        <DataTemplate DataType="{x:Type dashboard:DashboardViewModel}">
            <dashboard:DashboardView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type history:HistoryViewModel}">
            <history:HistoryView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type settings:SettingsViewModel}">
            <settings:SettingsView />
        </DataTemplate>

    </Application.Resources>
</Application>
