<UserControl x:Class="OG_opossum_command.Desktop.Dashboard.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:OG_opossum_command.Desktop.Dashboard"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=local:DashboardViewModel}"
             Focusable="False"
             AutomationProperties.Name="Dashboard">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Six tiles, stable positions (spec §14) -->
        <ItemsControl Grid.Row="0"
                      ItemsSource="{Binding Tiles}"
                      Focusable="False"
                      KeyboardNavigation.TabNavigation="Continue"
                      AutomationProperties.Name="Workflow tiles">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="3" Rows="2" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type local:WorkflowTile}">
                    <Button Style="{StaticResource OgocTile}"
                            Command="{Binding DataContext.RunCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}"
                            IsEnabled="{Binding IsEnabled}"
                            ToolTip="{Binding Description}"
                            AutomationProperties.Name="{Binding AutomationName}"
                            AutomationProperties.HelpText="{Binding Description}">
                        <TextBlock Text="{Binding Name}" TextWrapping="Wrap" TextAlignment="Center" />
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Feedback line -->
        <TextBlock Grid.Row="1"
                   Margin="6,4,6,0"
                   Text="{Binding StatusMessage}"
                   TextWrapping="Wrap"
                   AutomationProperties.LiveSetting="Polite" />

        <!-- Next schedule occurrence (spec §08) -->
        <TextBlock Grid.Row="2"
                   Margin="6,2,6,0"
                   Text="{Binding NextScheduled}"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />

        <!-- Today: remaining events from the profile's calendar file (ADR-011, ADR-039) -->
        <Border Grid.Row="3"
                Margin="6,6,6,0"
                Padding="8"
                BorderThickness="1"
                BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}"
                AutomationProperties.Name="Today">
            <StackPanel>
                <DockPanel LastChildFill="True">
                    <Button DockPanel.Dock="Right"
                            Content="_Refresh"
                            Style="{StaticResource OgocButton}"
                            Padding="10,2"
                            MinHeight="28"
                            Command="{Binding RefreshCalendarCommand}"
                            AutomationProperties.Name="Refresh today's calendar"
                            AutomationProperties.HelpText="Reads the calendar file again" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource OgocHeading}" Margin="0" Text="TODAY" />
                        <TextBlock Text="{Binding TodayStatus}"
                                   TextWrapping="Wrap"
                                   FontSize="12"
                                   Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                                   AutomationProperties.LiveSetting="Polite" />
                    </StackPanel>
                </DockPanel>
                <ItemsControl ItemsSource="{Binding Today}"
                              Margin="0,4,0,0"
                              Focusable="False"
                              KeyboardNavigation.TabNavigation="Continue"
                              Visibility="{Binding HasTodayEvents, Converter={StaticResource BoolToVis}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type local:TodayEvent}">
                            <Grid Margin="0,1" AutomationProperties.Name="{Binding AutomationName}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Time}" FontFamily="Consolas" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                    <Run Text="{Binding Subject, Mode=OneWay}" />
                                    <Run Text="{Binding Detail, Mode=OneWay}" FontSize="12" Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
                                </TextBlock>
                                <Button Grid.Column="2"
                                        Content="Open"
                                        Style="{StaticResource OgocButton}"
                                        Padding="8,0"
                                        MinHeight="24"
                                        Margin="8,0,0,0"
                                        Visibility="{Binding HasLink, Converter={StaticResource BoolToVis}}"
                                        Command="{Binding DataContext.OpenEventCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        AutomationProperties.Name="{Binding Subject, StringFormat=Open {0}}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- Interrupted runs waiting for the operator (spec §13 Needs attention) -->
        <Border Grid.Row="4"
                Margin="6,6,6,0"
                Padding="8"
                BorderThickness="2"
                BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}"
                Visibility="{Binding HasAttention, Converter={StaticResource BoolToVis}}"
                AutomationProperties.Name="Runs that need attention">
            <StackPanel>
                <TextBlock Style="{StaticResource OgocHeading}" Text="NEEDS ATTENTION (the app stopped while these were running)" />
                <ItemsControl ItemsSource="{Binding Attention}" Focusable="False" KeyboardNavigation.TabNavigation="Continue">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type local:AttentionItem}">
                            <Grid Margin="0,2" AutomationProperties.Name="{Binding AutomationName}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock FontWeight="SemiBold">
                                        <Run Text="{Binding WorkflowName, Mode=OneWay}" />
                                        <Run Text=" · " />
                                        <Run Text="{Binding Profile, Mode=OneWay}" />
                                        <Run Text=" · " />
                                        <Run Text="{Binding When, Mode=OneWay}" />
                                    </TextBlock>
                                    <TextBlock Text="{Binding Explanation}" TextWrapping="Wrap" FontSize="12" />
                                </StackPanel>
                                <Button Grid.Column="1"
                                        Content="_Resume"
                                        Style="{StaticResource OgocButton}"
                                        Margin="8,0,0,0"
                                        VerticalAlignment="Center"
                                        Command="{Binding DataContext.ResumeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        AutomationProperties.Name="Resume this run"
                                        AutomationProperties.HelpText="Starts a new run; steps that already completed are not repeated" />
                                <Button Grid.Column="2"
                                        Content="_Dismiss"
                                        Style="{StaticResource OgocButton}"
                                        Margin="8,0,0,0"
                                        VerticalAlignment="Center"
                                        Command="{Binding DataContext.DismissCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        AutomationProperties.Name="Dismiss this run"
                                        AutomationProperties.HelpText="Leaves things as they are; nothing is re-run" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- Workflow files that did not validate -->
        <Border Grid.Row="5"
                Margin="6,6,6,0"
                Padding="8"
                BorderThickness="1"
                BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}"
                Visibility="{Binding HasLoadErrors, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <TextBlock Style="{StaticResource OgocHeading}" Text="WORKFLOW FILES WITH PROBLEMS (fix the file, then switch profile to reload)" />
                <ItemsControl ItemsSource="{Binding LoadErrors}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- Active execution -->
        <Border Grid.Row="6"
                Margin="6,8,6,0"
                Padding="10"
                BorderThickness="2"
                BorderBrush="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"
                Visibility="{Binding HasActiveRun, Converter={StaticResource BoolToVis}}"
                AutomationProperties.Name="Active execution">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Style="{StaticResource OgocHeading}" Text="ACTIVE EXECUTION" />
                    <TextBlock FontSize="16" FontWeight="SemiBold" AutomationProperties.LiveSetting="Polite">
                        <Run Text="{Binding ActiveTitle, Mode=OneWay}" />
                        <Run Text="  ▸  " />
                        <Run Text="{Binding ActiveProgress, Mode=OneWay}" />
                    </TextBlock>
                    <ItemsControl ItemsSource="{Binding ActiveSteps}" Margin="0,6,0,0" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:StepRow}">
                                <TextBlock Margin="4,1" AutomationProperties.Name="{Binding Status}">
                                    <Run Text="{Binding Glyph, Mode=OneWay}" FontWeight="Bold" />
                                    <Run Text=" " />
                                    <Run Text="{Binding Text, Mode=OneWay}" />
                                </TextBlock>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
                <Button Grid.Column="1"
                        Content="_Cancel"
                        Style="{StaticResource OgocCancel}"
                        Command="{Binding CancelCommand}"
                        VerticalAlignment="Top"
                        Margin="12,0,0,0"
                        AutomationProperties.Name="Cancel the active run" />
            </Grid>
        </Border>

        <!-- Recent runs -->
        <DockPanel Grid.Row="7" Margin="6,10,6,0">
            <TextBlock DockPanel.Dock="Top" Style="{StaticResource OgocHeading}" Text="RECENT RUNS" />
            <ListView ItemsSource="{Binding RecentRuns}"
                      Style="{StaticResource OgocList}"
                      AutomationProperties.Name="Recent runs"
                      SelectionMode="Single">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="When" Width="130" DisplayMemberBinding="{Binding When}" />
                        <GridViewColumn Header="Workflow" Width="180" DisplayMemberBinding="{Binding WorkflowName}" />
                        <GridViewColumn Header="Status" Width="100" DisplayMemberBinding="{Binding Status}" />
                        <GridViewColumn Header="Result" Width="320" DisplayMemberBinding="{Binding Summary}" />
                    </GridView>
                </ListView.View>
            </ListView>
        </DockPanel>
    </Grid>
</UserControl>
