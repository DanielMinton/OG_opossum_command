<UserControl x:Class="OG_opossum_command.Desktop.History.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:a11y="clr-namespace:OG_opossum_command.Desktop.Accessibility"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:OG_opossum_command.Desktop.History"
             xmlns:dashboard="clr-namespace:OG_opossum_command.Desktop.Dashboard"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=local:HistoryViewModel}"
             Focusable="False"
             AutomationProperties.Name="History">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="280" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="*" MinWidth="240" />
        </Grid.ColumnDefinitions>

        <DockPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,0,0,12">
            <Button DockPanel.Dock="Right"
                    Style="{StaticResource OgocButton}"
                    Command="{Binding RefreshCommand}"
                    AutomationProperties.Name="Refresh history">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource OgocIcon}" Text="&#xE72C;" FontSize="{DynamicResource OgocHeadingSize}" Margin="0,0,8,0" />
                    <AccessText Text="_Refresh" />
                </StackPanel>
            </Button>
            <TextBlock Style="{StaticResource OgocCaption}" FontSize="{DynamicResource OgocBodySize}" VerticalAlignment="Center"
                       AutomationProperties.HeadingLevel="Level2">
                <Run Text="Runs in the " /><Run Text="{Binding ProfileName, Mode=OneWay}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" /><Run Text=" profile" />
            </TextBlock>
        </DockPanel>

        <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource OgocCard}" Margin="0" Padding="8">
            <ListView ItemsSource="{Binding Runs}"
                      SelectedItem="{Binding SelectedRun, Mode=TwoWay}"
                      Style="{StaticResource OgocList}"
                      SelectionMode="Single"
                      AutomationProperties.Name="Past runs">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="When" Width="140" DisplayMemberBinding="{Binding When}" />
                        <GridViewColumn Header="Workflow" Width="160" DisplayMemberBinding="{Binding WorkflowName}" />
                        <GridViewColumn Header="Status" Width="100" DisplayMemberBinding="{Binding Status}" />
                    </GridView>
                </ListView.View>
            </ListView>
        </Border>

        <GridSplitter Grid.Row="1" Grid.Column="1"
                      Width="12"
                      HorizontalAlignment="Stretch"
                      Background="Transparent"
                      FocusVisualStyle="{StaticResource OgocFocusVisual}"
                      AutomationProperties.Name="Resize history panes" />

        <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource OgocCard}" Margin="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="{Binding DetailTitle}"
                           FontSize="{DynamicResource OgocLargeSize}"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap"
                           Margin="0,0,0,8"
                           a11y:LiveRegion.Announce="True" />

                <ItemsControl Grid.Row="1" ItemsSource="{Binding Steps}" Focusable="False" AutomationProperties.Name="Steps of the selected run">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type dashboard:StepRow}">
                            <TextBlock Margin="0,2" TextWrapping="Wrap" AutomationProperties.Name="{Binding AutomationName}">
                                <Run Text="{Binding Glyph, Mode=OneWay}" FontWeight="Bold" />
                                <Run Text=" " />
                                <Run Text="{Binding Text, Mode=OneWay}" />
                            </TextBlock>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Grid.Row="2" Style="{StaticResource OgocHeading}" FontSize="{DynamicResource OgocBodySize}" Text="Events" Margin="0,14,0,4" />

                <ListBox Grid.Row="3"
                         ItemsSource="{Binding Events}"
                         FontFamily="{StaticResource OgocMonoFont}"
                         FontSize="{DynamicResource OgocSmallSize}"
                         FocusVisualStyle="{StaticResource OgocFocusVisual}"
                         Background="Transparent"
                         BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         AutomationProperties.Name="Events of the selected run">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>
    </Grid>
</UserControl>
